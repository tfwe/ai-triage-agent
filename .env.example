# Copy to .env and fill in what you need. Nothing here is a working credential.
#
# Provider: "ollama" (any OpenAI-compatible local server: Ollama or LM Studio)
# or "openai" (api.openai.com).
LLM_PROVIDER=ollama

# live   = call the model over the network
# record = call the model and append every request/response to REPLAY_PATH
# replay = answer from REPLAY_PATH with no network at all (used by the eval)
LLM_MODE=live

# OpenAI (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-placeholder-key
OPENAI_MODEL=gpt-5.6-luna
# Optional: any OpenAI-compatible gateway (OpenRouter, vLLM, Azure) instead of
# api.openai.com. Leave empty to use the OpenAI default.
OPENAI_BASE_URL=

# Local model server. LM Studio usually listens on 1234, not 11434.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=devstral-small-2:24b

# Optional. When empty, the agent is told the lookup is unavailable and decides
# from local telemetry only. No key is required for the test suite or the eval.
ABUSEIPDB_API_KEY=abuseipdb-placeholder-key

# Where queries run, and where a recorded run is written/replayed from.
TRIAGE_DB_PATH=data/processed/triage.db
REPLAY_PATH=eval/recordings/agent.jsonl