# (eval/results/real-vendor-holdout-report.json).
eval/recordings/real-vendor-holdout-*.jsonl
eval/results/real-vendor-holdout-r*.json
eval/results/real-vendor-holdout-r*.txt
eval/results/real-vendor-holdout-draw0.json
eval/results/real-vendor-holdout-draw0.txt

