        },
        "min_hits": 1,
        "note": "DGA HTTP-host beacons"
      },
      {
        "type": "action",
        "verbs": [
          "block",
          "perimeter"
        ],
        "reference": [
          "203.0.113.127"
        ]
      },
      {
        "type": "restraint",
        "forbid": [
          "isolate 203.0.113.127"
        ]
      }
    ]
  },
