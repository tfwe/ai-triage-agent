      {"table": "endpoint_events", "where": "hostname = 'WEB-BO-01' AND event_data LIKE '%nmap -sS%'", "signature": "nmap -sS -Pn 10.20.0.0/24"},
      {"table": "alerts", "where": "src_ip = '185.220.101.4'", "signature": "ET SCAN Potential SSH Scan"}
    ]
  },
